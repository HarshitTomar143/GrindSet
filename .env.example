# Copy this file to .env.local and fill in your PostgreSQL connection string.
# Supabase / Neon / Railway / local Postgres all use this format:
DATABASE_URL=postgresql://neondb_owner:npg_KUCIlLMnj1i6@ep-red-king-aimp0x7o-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: force-disable SSL for a local database (default: SSL on for remote hosts)
# DATABASE_SSL=false

# Password for the /admin panel. Pick something strong.
ADMIN_PASSWORD=your-password

# Cloudflare R2 - holds the question diagrams (MP Police).
# R2 dashboard -> Manage R2 API Tokens -> create a token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket, no trailing slash: its r2.dev URL or your custom domain.
R2_PUBLIC_URL=
