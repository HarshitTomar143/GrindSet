# Copy this file to .env.local and fill in your PostgreSQL connection string.
# Supabase / Neon / Railway / local Postgres all use this format:
DATABASE_URL=postgresql://neondb_owner:npg_KUCIlLMnj1i6@ep-red-king-aimp0x7o-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional: force-disable SSL for a local database (default: SSL on for remote hosts)
# DATABASE_SSL=false

# Password for the /admin panel. Pick something strong.
ADMIN_PASSWORD=your-passwor

# Cloudflare R2 - holds the question diagrams (MP Police).
# R2 dashboard -> Manage R2 API Tokens -> create a token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket, no trailing slash: its r2.dev URL or your custom domain.
R2_PUBLIC_URL=

# The site's public address, no trailing slash, e.g. https://your-domain.
# Canonical links, sitemap.xml and robots.txt are built on it. Falls back to NEXTAUTH_URL.
SITE_URL=

# Sign-in for candidates (next-auth).
# NEXTAUTH_SECRET signs the session cookie: any long random string, e.g. `openssl rand -base64 48`.
# NEXTAUTH_URL is the site's own address: http://localhost:3000 locally, https://your-domain in production.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: "Continue with Google". Leave empty to offer email + password only.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
